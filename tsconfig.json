{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "rootDir": ".",
    "outDir": "dist/vercel",
    "strict": true,
    "noEmitOnError": true,
    "skipLibCheck": true
  },
  "include": ["api/**/*.ts"]
}
